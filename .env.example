# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL
POSTGRES_DB=hr2
POSTGRES_USER=hr2
POSTGRES_PASSWORD=hr2
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Authentik OIDC
# Redirect URI in Authentik: http://localhost:8000/oidc/callback/
#
# authorize / token / userinfo are often global (no slug):
#   https://auth.example.com/application/o/authorize/
# JWKS and issuer MUST include the application slug:
#   https://auth.example.com/application/o/<slug>/.well-known/openid-configuration
#   https://auth.example.com/application/o/<slug>/jwks/
# Do NOT use .../application/o/jwks/ — Authentik treats "jwks" as the slug.
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.example.com/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.example.com/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.example.com/application/o/userinfo/
OIDC_OP_ISSUER=https://auth.example.com/application/o/<slug>/
OIDC_OP_JWKS_ENDPOINT=https://auth.example.com/application/o/<slug>/jwks/
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid profile email
